<sdf version="1.7">
  <model name="RMUL_2026">
    <static>true</static>
    <link name="field">
      <visual name="visual">
        <geometry>
          <mesh>
            <!-- The visual-only mesh duplicates the wall faces with reversed winding. -->
            <uri>model://RMUL2026H_world/meshes/RMUL_2026H_visual.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>
      <collision name="collision">
        <max_contacts>10</max_contacts>
        <geometry>
          <mesh>
            <uri>model://RMUL2026H_world/meshes/RMUL_2026H.stl</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
          <contact>
            <collide_bitmask>1</collide_bitmask>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e13</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>

      <!--
        Each highland is 2.0 x 5.0 x 0.2 m. The corrected mesh contains the
        platform bodies; these two boxes add the 0.15 x 1.8 x 0.2 m guard
        strips shown in the field drawing. Their bottom faces sit at z=0.2 m.
      -->
      <visual name="positive_highland_guard_visual">
        <pose>1.575 -0.8 0.3 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 1.8 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>
      <collision name="positive_highland_guard_collision">
        <pose>1.575 -0.8 0.3 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 1.8 0.2</size>
          </box>
        </geometry>
      </collision>

      <visual name="negative_highland_guard_visual">
        <pose>-1.575 0.8 0.3 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 1.8 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.01 0.01 0.01 1</specular>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>
      <collision name="negative_highland_guard_collision">
        <pose>-1.575 0.8 0.3 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 1.8 0.2</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
