<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>recruitment_sim_description</name>
  <version>0.1.0</version>
  <description>Robot and field descriptions, model assets, conversion utilities and Gazebo plugins.</description>
  <maintainer email="maintainers@example.com">Recruitment Simulation Maintainers</maintainer>
  <license>Apache-2.0</license>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>
  <depend>rclcpp</depend>
  <depend>recruitment_sim_interfaces</depend>
  <depend>recruitment_sim_robot_base</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-setuptools</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
