<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>recruitment_sim_player_web</name>
  <version>0.1.0</version>
  <description>Unified browser player and referee UI with WebRTC and ROS 2 integration.</description>
  <maintainer email="maintainers@example.com">Recruitment Simulation Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>python3-aiohttp</exec_depend>
  <exec_depend>python3-aiortc</exec_depend>
  <exec_depend>python3-av</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>recruitment_sim_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
