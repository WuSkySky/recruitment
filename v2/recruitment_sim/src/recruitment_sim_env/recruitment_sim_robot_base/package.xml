<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>recruitment_sim_robot_base</name>
  <version>0.1.0</version>
  <description>ROS 2 controllers and Gazebo transport adapters for recruitment simulation robots.</description>
  <maintainer email="maintainers@example.com">Recruitment Simulation Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>ignition-msgs8</depend>
  <depend>ignition-transport11</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>recruitment_sim_interfaces</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
